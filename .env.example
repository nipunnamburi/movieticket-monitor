# ─── BMS Monitor — Environment Variables ───────────────────────────────────
# Copy this file to .env for local dev, OR set these in your cloud dashboard.
# On Railway: Settings → Variables
# On Render:  Environment → Add Environment Variable

# ── Gmail credentials ────────────────────────────────────────────────────────
EMAIL_FROM=your.gmail@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=where.alerts.go@gmail.com

# ── Optional overrides ───────────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ── App settings ─────────────────────────────────────────────────────────────
# PORT is auto-set by Railway/Render — don't set manually on cloud
# DATABASE_PATH=/data/monitors.db   ← auto-set by Dockerfile for cloud
