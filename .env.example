# ─────────────────────────────────────────────────────────────────────────────
# BookMyShow Live Monitor — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Database Connection (PostgreSQL: Local, Docker, Neon, Supabase, or Railway)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/bms_monitor?schema=public"

# Redis Connection (Local or Cloud Redis)
REDIS_URL="redis://localhost:6379"

# Server Port
PORT=5055
NODE_ENV="development"

# ── Email Alert Credentials (Resend — Recommended) ───────────────────────────
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM="BookMyShow Alerts <onboarding@resend.dev>"
DEFAULT_EMAIL_TO="your-email@gmail.com"

# ── Fallback: Gmail / SMTP ───────────────────────────────────────────────────
EMAIL_FROM="your-email@gmail.com"
EMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx" # 16-character App Password from https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587

# ── WhatsApp / SMS Notifications (Twilio) ────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
DEFAULT_WHATSAPP_TO="+919876543210"

# ── Free WhatsApp Fallback (CallMeBot) ─────────────────────────────────────────
# Obtain free API key from https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_API_KEY=""

# ── GitHub Actions Cloud Runner (Optional) ───────────────────────────────────
GITHUB_TOKEN=""
GITHUB_REPO="owner/repo"
