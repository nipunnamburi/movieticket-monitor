# ─── BMS Monitor — Environment Variables ─────────────────────────────────────
#
# GitHub Actions Secrets  →  repo Settings → Secrets and variables → Actions
# Vercel Environment Vars →  project Settings → Environment Variables
#
# ── Required everywhere ───────────────────────────────────────────────────────

# Neon Postgres connection string (get from console.neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Gmail credentials
EMAIL_FROM=your.gmail@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=alerts@gmail.com

# ── Required in Vercel only ───────────────────────────────────────────────────

# GitHub Personal Access Token (repo + workflow scope) — for "Check Now" button
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your GitHub repo in "owner/repo" format
GITHUB_REPO=yourname/bms-monitor
