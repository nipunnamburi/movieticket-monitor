datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String?   // Nullable — Google OAuth users have no password
  name       String?
  googleId   String?   @unique // Google OAuth subject ID
  avatarUrl  String?   // Google profile picture URL
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  monitors   Monitor[]
}

model Monitor {
  id                String     @id @default(cuid())
  clientId          String     @default("default")
  userId            String?
  user              User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  url               String
  city              String
  language          String?
  status            String     @default("active") // "active" | "paused" | "error"
  checkIntervalSec  Int        @default(30)
  lastChecked       DateTime?
  lastError         String?
  snapshot          Json?      // Latest showtimes state snapshot
  filterTheatres    String[]   @default([])
  filterDates       String[]   @default([])
  filterTimeFrom    String?
  filterTimeTo      String?
  emailTo           String?
  whatsappPhone     String?
  alerts            AlertLog[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([clientId])
  @@index([userId])
  @@index([status])
}

model AlertLog {
  id         String   @id @default(cuid())
  monitorId  String
  monitor    Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  openings   Json
  channels   String[] @default([]) // ["TELEGRAM", "DISCORD", "EMAIL"]
  createdAt  DateTime @default(now())

  @@index([monitorId, createdAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
